diff --git a/style.css b/style.css
index 9ed6b46..347721e 100644
--- a/style.css
+++ b/style.css
@@ -2612,3 +2612,192 @@ and (pointer: coarse) {
         padding: 14px 18px;
     }
 }
+/* Homepage: a cream glass glaze behind the existing dark wordmark. */
+.home-page .site-header {
+    background: transparent;
+    box-shadow: 0 6px 20px #2d0f101c;
+}
+.home-page .site-header::before {
+    content: "";
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    background: linear-gradient(110deg, #fff8f2f5, #fbe3e9ed);
+    -webkit-backdrop-filter: blur(12px);
+    backdrop-filter: blur(12px);
+}
+.home-page .site-header .main-navigation:not(.is-open) a,
+.home-page .site-header .header-icon-button {
+    color: var(--deep-chocolate);
+}
+.home-page .site-header .main-navigation:not(.is-open) a:is(:hover, :focus-visible, .active-nav-link) {
+    color: #86284d;
+}
+.home-page .site-header .mobile-menu-button span {
+    background: var(--deep-chocolate);
+}
+.home-page .site-header .cart-count {
+    border-color: #fff4ee;
+}
+
+/* Homepage cake feature: one custom centerpiece, two supporting cakes. */
+.home-page .cake-showcase {
+    min-width: 0;
+    min-height: 0;
+    display: grid;
+    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
+    grid-template-rows: repeat(2, minmax(0, 1fr));
+    gap: clamp(8px, 1.2vw, 18px);
+    align-items: stretch;
+}
+.home-page .cake-feature-inner {
+    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
+}
+.home-page .cake-showcase figure {
+    display: grid;
+    grid-template-rows: minmax(0, 1fr) auto;
+    min-width: 0;
+    min-height: 0;
+    margin: 0;
+    padding: 12px 8px 14px;
+    border: 1px solid #e9c9c5;
+    border-radius: 18px;
+    background: radial-gradient(ellipse at center, #fff9f5 20%, #fae4e8 100%);
+}
+.home-page .cake-showcase .cake-showcase-main {
+    grid-row: span 2;
+    background: radial-gradient(ellipse at center, #fff9f5 20%, #f3d9e2 100%);
+}
+.home-page .cake-showcase img {
+    display: block;
+    width: 100%;
+    height: clamp(110px, 13vw, 195px);
+    align-self: center;
+    object-fit: contain;
+    filter: drop-shadow(0 8px 10px #421a1226);
+}
+.home-page .cake-showcase-main img {
+    height: clamp(200px, 29vw, 440px);
+}
+.home-page .cake-showcase figcaption {
+    color: #5f352c;
+    font-size: clamp(11px, 1vw, 14px);
+    font-weight: 800;
+    line-height: 1.25;
+    text-align: center;
+}
+@media (max-width: 980px) {
+    .home-page .cake-feature-inner { grid-template-columns: minmax(0, 1fr); }
+    .home-page .cake-showcase { width: min(100%, 640px); margin-inline: auto; }
+}
+@media (max-width: 500px) {
+    .home-page .cake-showcase {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+        grid-template-rows: auto;
+    }
+    .home-page .cake-showcase .cake-showcase-main { grid-row: auto; grid-column: 1 / -1; }
+    .home-page .cake-showcase-main img { height: 250px; }
+}
+
+/* Quick contact in the footer; full help lives on the Contact page. */
+.site-footer .footer-contact {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: center;
+    gap: 8px 24px;
+    padding: 8px var(--side-padding) 18px;
+    color: #e4c8ba;
+    font-size: 13px;
+}
+.site-footer .footer-contact a,
+.contact-links a {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    min-width: 0;
+    text-decoration: none;
+}
+.site-footer .footer-contact a { color: inherit; }
+.site-footer .footer-contact a:is(:hover, :focus-visible) { color: #ffd4ed; text-decoration: underline; }
+.site-footer .footer-texas {
+    margin: 0;
+    padding: 4px var(--side-padding) 12px;
+    color: #e4c8ba;
+    font-size: 13px;
+    text-align: center;
+}
+.footer-contact svg,
+.contact-links svg,
+.contact-card-icon svg {
+    flex: 0 0 18px;
+    width: 18px;
+    height: 18px;
+    fill: none;
+    stroke: currentColor;
+    stroke-width: 1.7;
+    stroke-linecap: round;
+    stroke-linejoin: round;
+}
+
+/* Contact page */
+.contact-main {
+    background: linear-gradient(155deg, #fbe5ec, #fff8f1 56%);
+    padding: clamp(38px, 6vw, 86px) var(--side-padding) 54px;
+    color: #542b22;
+}
+.contact-intro {
+    max-width: 720px;
+    margin: 0 auto clamp(24px, 4vw, 48px);
+    text-align: center;
+}
+.contact-intro .contact-kicker {
+    color: #86284d;
+    font-size: 12px;
+    font-weight: 800;
+    letter-spacing: .12em;
+}
