+function getLightenedCakePreviewColor(color) {
+    if (!color || color === "original") {
+        return color;
+    }
+
+    const normalizedColor =
+        normalizeHexColor(color);
+
+    const isBlackShade = [
+        "#000000",
+        "#111111",
+        "#24201F"
+    ].includes(normalizedColor);
+
+    return mixHexColor(
+        "#FFF1DC",
+        normalizedColor,
+        isBlackShade ? 0.78 : 0.48
+    );
+}
+
